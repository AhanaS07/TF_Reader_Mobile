# Local dev overrides. Gitignored (.env*) — never commit real values here.

# Point Download at the real backend (tf_reader_backend_temp, :8080) instead of the mock (:4000).
# See src/features/download/config.ts and API_CONTRACT_NOTES.md B2.
EXPO_PUBLIC_USE_REAL_BACKEND=

# Override sync's own base URL — only needed if syncConfig.ts's host resolution guesses wrong for
# your setup (e.g. a real device on a network Metro's dev server can't see). Android emulator
# already resolves to the host machine via 10.0.2.2 automatically; you should not need this there.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080
