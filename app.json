{
  "expo": {
    "name": "TF Reader",
    "slug": "tf-reader-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tfreader",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["assets/**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taylorandfrancis.tfreader.dev"
    },
    "android": {
      "package": "com.taylorandfrancis.tfreader.dev",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-dev-client", "expo-font"]
  }
}
